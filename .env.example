# ---- Telegram ----
BOT1_TOKEN=                      # slow lane (general news) — from @BotFather
BOT2_TOKEN=                      # fast lane; leave empty for single-bot mode
SLOW_LANE_CHANNEL_ID=            # default/test channel, e.g. -1001234567890
ADMIN_CHANNEL_ID=                # private channel for review + health alerts
ADMIN_DM_ID=                     # fallback if no admin channel (your user id)

# ---- Per-category channels (optional; unset falls back to SLOW_LANE_CHANNEL_ID)
CHANNEL_CRYPTO_NEWS=
CHANNEL_US_POLITICS=
CHANNEL_INDIA_POLITICS=
CHANNEL_US_ECON_CALENDAR=
CHANNEL_INDIA_ECON_CALENDAR=
CHANNEL_GOLD_NEWS=
CHANNEL_US_STOCK_MARKET=
CHANNEL_DAILY_NEWS=
CHANNEL_INDIA_MARKET_IPO=
CHANNEL_US_MARKET_IPO=
CHANNEL_ECON_CALENDAR_ALERTS=

# ---- LLM (b.ai, OpenAI-compatible) ----
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=deepseek-v4-flash-vision-exp
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=120
SLOW_BATCH_SIZE=10
FAST_FILTER_WORKERS=6

# ---- Scheduling (minutes) ----
SLOW_INTERVAL_MIN=20
FAST_INTERVAL_MIN=3
HEALTH_INTERVAL_MIN=60
CALENDAR_HOUR=8
CALENDAR_LOOKAHEAD_DAYS=3

# ---- Rate limits (Telegram) ----
RATE_GLOBAL_PER_SEC=25
RATE_PER_CHAT_SEC=1.1
RATE_PER_CHAT_PER_MIN=19

# ---- Content ----
SNIPPET_MAX=280
MAX_ITEMS_PER_CYCLE=40
FUZZY_THRESHOLD=88
DEDUP_WINDOW_HOURS=72

# ---- Excluded sources (do not enable without explicit decision) ----
ENABLE_GDELT=0
ENABLE_MONEYCONTROL=0
ENABLE_FINNHUB=0

# ---- Misc ----
SEC_EDGAR_UA=AslamNewsMedia/1.0 (contact: telegram @Aslamnewsmedia_bot)
DRY_RUN=0
LOG_LEVEL=INFO
